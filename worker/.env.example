# Copy to .env and fill in values. Dokploy reads this same file when set as
# the project's environment source.

# Shared bearer token. Generate with: openssl rand -hex 32
# The same value must be set as BENCHMARK_WORKER_SECRET on jsperf.net (Vercel).
BENCHMARK_WORKER_SECRET=change-me-to-a-32-byte-hex-string

# Capacity. Each Docker-backed job pins a CPU; keep MAX_CONCURRENT_JOBS at or
# below the host's core count. Requests past MAX_QUEUED_JOBS get a 503.
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=12
MAX_CONCURRENT_SYNC_REQUESTS=4

# Set to 0 to skip wrapping benchmark runs with `perf stat`.
# Useful when the host kernel rejects PERFMON / SYS_PTRACE (some Hostinger
# kernels). Leaving it at 1 is harmless: missing counters render as "—".
# Perf runs execute as root inside the container (all other capabilities
# dropped); non-perf runs use RUNTIME_CONTAINER_USER.
COLLECT_PERF=1
# RUNTIME_CONTAINER_USER=65534:65534

# Cleanup. The reaper force-removes labeled runtime containers older than
# ORPHAN_CONTAINER_MAX_AGE_MS (crash/redeploy leftovers), deletes stale
# per-run script dirs, and prunes versioned runtime images unused for
# IMAGE_RETENTION_HOURS. Defaults are fine for most hosts.
# REAPER_INTERVAL_MS=60000
# ORPHAN_CONTAINER_MAX_AGE_MS=120000
# STALE_WORK_DIR_MAX_AGE_MS=900000
# IMAGE_RETENTION_HOURS=168
